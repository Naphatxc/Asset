generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model categories {
  category_id   Int         @id @default(autoincrement()) @db.UnsignedInt
  category_name String      @unique(map: "category_name") @db.VarChar(100)
  description   String?     @db.Text
  equipment     equipment[]
  materials     materials[]
}

model equipment {
  equipment_id    Int               @id @default(autoincrement()) @db.UnsignedInt
  equipment_name  String            @db.VarChar(150)
  category_id     Int               @db.UnsignedInt
  location_id     Int?              @db.UnsignedInt
  fiscal_year     Int?              @db.Year
  description     String?           @db.Text
  receive_date    DateTime?         @db.Date
  remark          String?           @db.Text
  categories      categories        @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_equipment_category")
  locations       locations?        @relation(fields: [location_id], references: [location_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_equipment_location")
  equipment_items equipment_items[]

  @@index([category_id], map: "fk_equipment_category")
  @@index([location_id], map: "fk_equipment_location")
}

model equipment_history {
  history_id      BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  item_id         Int                      @db.UnsignedInt
  action          equipment_history_action
  old_data        Json?
  new_data        Json?
  changed_by      Int?                     @db.UnsignedInt
  created_at      DateTime                 @default(now()) @db.DateTime(0)
  equipment_items equipment_items          @relation(fields: [item_id], references: [item_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_history_item")
  users           users?                   @relation(fields: [changed_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_history_user")

  @@index([changed_by], map: "idx_equipment_history_changed_by")
  @@index([item_id], map: "idx_equipment_history_item")
}

model equipment_items {
  item_id           Int                    @id @default(autoincrement()) @db.UnsignedInt
  equipment_id      Int                    @db.UnsignedInt
  equipment_name    String                 @db.VarChar(150)
  equipment_code    String                 @unique(map: "equipment_code") @db.VarChar(50)
  status            equipment_items_status @default(available)
  price             Decimal?               @db.Decimal(10, 2)
  warranty_expire   DateTime?              @db.Date
  created_at        DateTime               @default(now()) @db.DateTime(0)
  updated_at        DateTime               @default(now()) @updatedAt @db.DateTime(0)
  deleted_at        DateTime?              @db.DateTime(0)
  equipment_history equipment_history[]
  equipment         equipment              @relation(fields: [equipment_id], references: [equipment_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_item_equipment")

  @@index([equipment_id], map: "fk_item_equipment")
}

model locations {
  location_id   Int         @id @default(autoincrement()) @db.UnsignedInt
  location_name String      @db.VarChar(100)
  building      String?     @db.VarChar(100)
  room          String?     @db.VarChar(30)
  equipment     equipment[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model materials {
  material_id      Int        @id @default(autoincrement()) @db.UnsignedInt
  material_code    String     @unique(map: "material_code") @db.VarChar(50)
  material_name    String     @db.VarChar(150)
  category_id      Int        @db.UnsignedInt
  quantity         Int        @default(0)
  minimum_quantity Int        @default(0)
  expire_date      DateTime?  @db.Date
  unit_name        String     @db.VarChar(50)
  unit_price       Decimal?   @db.Decimal(10, 2)
  remark           String?    @db.Text
  categories       categories @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_material_category")

  @@index([category_id], map: "fk_material_category")
}

model users {
  user_id           Int                 @id @default(autoincrement()) @db.UnsignedInt
  name              String              @db.VarChar(100)
  email             String              @unique(map: "email") @db.VarChar(255)
  password_hash     String              @db.VarChar(255)
  role              users_role          @default(user)
  created_at        DateTime            @default(now()) @db.DateTime(0)
  equipment_history equipment_history[]
}

enum equipment_history_action {
  created
  updated
  status_changed
  deleted
  restored
}

enum equipment_items_status {
  available
  borrowed
  pending_repair
  repairing
}

enum users_role {
  admin
  user
}
