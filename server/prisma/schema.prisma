generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model categories {
  category_id   Int         @id @default(autoincrement()) @db.UnsignedInt
  category_name String      @unique(map: "category_name") @db.VarChar(100)
  description   String?     @db.Text
  // ใช้ออกรหัสครุภัณฑ์อัตโนมัติ (เช่น "PC" -> PC-0005) ไม่บังคับกรอก เพราะหมวดหมู่เก่าอาจยังไม่ได้ตั้งไว้
  code_prefix   String?     @unique(map: "categories_code_prefix") @db.VarChar(20)
  equipment     equipment[]
  materials     materials[]
}

model equipment {
  equipment_id    Int               @id @default(autoincrement()) @db.UnsignedInt
  // 255 ไม่ใช่ 150 เพราะข้อมูลครุภัณฑ์จริงจากระบบเก่า (ยังไม่ได้ migrate) มีชื่อยาวสุดถึง 194 ตัวอักษร
  equipment_name  String            @db.VarChar(255)
  category_id     Int               @db.UnsignedInt
  location_id     Int?              @db.UnsignedInt
  fiscal_year     Int?              @db.Year
  description     String?           @db.Text
  receive_date    DateTime?         @db.Date
  remark          String?           @db.Text
  categories      categories        @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_equipment_category")
  locations       locations?        @relation(fields: [location_id], references: [location_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_equipment_location")
  equipment_items equipment_items[]

  @@index([category_id], map: "fk_equipment_category")
  @@index([location_id], map: "fk_equipment_location")
}

model equipment_history {
  history_id      BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  item_id         Int                      @db.UnsignedInt
  action          equipment_history_action
  old_data        Json?
  new_data        Json?
  changed_by      Int?                     @db.UnsignedInt
  created_at      DateTime                 @default(now()) @db.DateTime(0)
  equipment_items equipment_items          @relation(fields: [item_id], references: [item_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_history_item")
  users           users?                   @relation(fields: [changed_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_history_user")

  @@index([changed_by], map: "idx_equipment_history_changed_by")
  @@index([item_id], map: "idx_equipment_history_item")
}

model equipment_items {
  item_id           Int                    @id @default(autoincrement()) @db.UnsignedInt
  equipment_id      Int                    @db.UnsignedInt
  equipment_name    String                 @db.VarChar(255)
  equipment_code    String                 @unique(map: "equipment_code") @db.VarChar(50)
  status            equipment_items_status @default(available)
  price             Decimal?               @db.Decimal(10, 2)
  warranty_expire   DateTime?              @db.Date
  // ชื่อไฟล์รูปใน uploads/equipment (ไม่ใช่ path เต็ม) ชิ้นละหนึ่งรูป อัปโหลดใหม่แล้วไฟล์เดิมถูกลบทิ้ง
  image_path        String?                @db.VarChar(255)
  created_at        DateTime               @default(now()) @db.DateTime(0)
  updated_at        DateTime               @default(now()) @updatedAt @db.DateTime(0)
  deleted_at        DateTime?              @db.DateTime(0)
  borrow_details    borrow_details[]
  equipment_history equipment_history[]
  equipment         equipment              @relation(fields: [equipment_id], references: [equipment_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_item_equipment")
  repairs           repairs[]
  audit_records     audit_records[]

  @@index([equipment_id], map: "fk_item_equipment")
}

model locations {
  location_id            Int             @id @default(autoincrement()) @db.UnsignedInt
  location_name          String          @db.VarChar(100)
  building               String?         @db.VarChar(100)
  room                   String?         @db.VarChar(30)
  equipment              equipment[]
  audit_records_expected audit_records[] @relation("audit_expected_location")
  audit_records_found    audit_records[] @relation("audit_found_location")
  audit_records_moved    audit_records[] @relation("audit_moved_from_location")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model materials {
  material_id          Int                    @id @default(autoincrement()) @db.UnsignedInt
  material_code        String                 @unique(map: "material_code") @db.VarChar(50)
  material_name        String                 @db.VarChar(150)
  category_id          Int                    @db.UnsignedInt
  quantity             Int                    @default(0)
  minimum_quantity     Int                    @default(0)
  expire_date          DateTime?              @db.Date
  unit_name            String                 @db.VarChar(50)
  unit_price           Decimal?               @db.Decimal(10, 2)
  remark               String?                @db.Text
  // ชื่อไฟล์รูปใน uploads/materials (เหมือน equipment_items.image_path)
  image_path           String?                @db.VarChar(255)
  // Soft delete เหมือน equipment_items — กันลบแล้วประวัติการเบิกใน material_withdrawals อ้างอิงไม่ได้
  deleted_at           DateTime?              @db.DateTime(0)
  categories           categories             @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_material_category")
  material_withdrawals material_withdrawals[]

  @@index([category_id], map: "fk_material_category")
}

// ประวัติการเบิกวัสดุ — ตัดยอด quantity ทันทีตอนเบิก ไม่มีขั้นตอนรออนุมัติแบบใบยืมครุภัณฑ์ เพราะวัสดุใช้แล้วหมดไป
// ไม่มีการคืน (ต่างจาก borrows/borrow_details ที่ต้อง track คืนของ)
model material_withdrawals {
  withdrawal_id Int       @id @default(autoincrement()) @db.UnsignedInt
  material_id   Int       @db.UnsignedInt
  user_id       Int       @db.UnsignedInt
  quantity      Int
  remark        String?   @db.Text
  withdrawn_at  DateTime  @default(now()) @db.DateTime(0)
  materials     materials @relation(fields: [material_id], references: [material_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_withdrawal_material")
  users         users     @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_withdrawal_user")

  @@index([material_id], map: "idx_withdrawals_material")
  @@index([user_id], map: "idx_withdrawals_user")
}

model users {
  user_id                 Int                     @id @default(autoincrement()) @db.UnsignedInt
  name                    String                  @db.VarChar(100)
  email                   String                  @unique(map: "email") @db.VarChar(255)
  password_hash           String                  @db.VarChar(255)
  role                    users_role              @default(user)
  created_at              DateTime                @default(now()) @db.DateTime(0)
  // session ที่ login ก่อนเวลานี้ใช้ไม่ได้แล้ว (เปลี่ยน/รีเซ็ตรหัสแล้วอุปกรณ์อื่นต้อง login ใหม่)
  password_changed_at     DateTime?               @db.DateTime(0)
  borrows                 borrows[]
  equipment_history       equipment_history[]
  repairs                 repairs[]
  material_withdrawals    material_withdrawals[]
  audit_rounds_opened     audit_rounds[]          @relation("audit_round_opened_by")
  audit_rounds_closed     audit_rounds[]          @relation("audit_round_closed_by")
  audit_records           audit_records[]
  password_reset_tokens   password_reset_tokens[]
  returned_borrow_details borrow_details[]        @relation("borrow_detail_returned_by")
}

// ลิงก์ "ลืมรหัสผ่าน" ที่ส่งทางอีเมล เก็บแค่ hash (sha256) ของ token ไม่เก็บตัวจริง
// DB รั่วก็เอาไปตั้งรหัสแทนเจ้าของไม่ได้ ใช้ได้ครั้งเดียว (used_at) และหมดอายุตาม expires_at
model password_reset_tokens {
  token_id   Int       @id @default(autoincrement()) @db.UnsignedInt
  user_id    Int       @db.UnsignedInt
  token_hash String    @unique(map: "uq_password_reset_token_hash") @db.Char(64)
  expires_at DateTime  @db.DateTime(0)
  used_at    DateTime? @db.DateTime(0)
  created_at DateTime  @default(now()) @db.DateTime(0)
  users      users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_password_reset_user")

  @@index([user_id], map: "fk_password_reset_user")
}

model borrow_details {
  borrow_detail_id    Int             @id @default(autoincrement()) @db.UnsignedInt
  borrow_id           Int             @db.UnsignedInt
  item_id             Int             @db.UnsignedInt
  return_date         DateTime        @db.DateTime(0)
  return_requested_at DateTime?       @db.DateTime(0)
  returned_at         DateTime?       @db.DateTime(0)
  // admin ที่กดรับคืน/ยืนยันการคืน (ผู้ยืมกดคืนเองแค่ขอคืน ยังไม่นับว่าคืน) ใบเก่าเติมจาก equipment_history ตอน migrate
  returned_by         Int?            @db.UnsignedInt
  borrows             borrows         @relation(fields: [borrow_id], references: [borrow_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_borrow_detail_borrow")
  equipment_items     equipment_items @relation(fields: [item_id], references: [item_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_borrow_detail_item")
  returned_user       users?          @relation("borrow_detail_returned_by", fields: [returned_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_borrow_detail_returned_by")

  @@index([borrow_id], map: "idx_borrow_details_borrow")
  @@index([item_id], map: "idx_borrow_details_item")
  @@index([returned_by], map: "fk_borrow_detail_returned_by")
}

model borrows {
  borrow_id      Int              @id @default(autoincrement()) @db.UnsignedInt
  user_id        Int              @db.UnsignedInt
  borrow_date    DateTime         @default(now()) @db.DateTime(0)
  status         borrows_status   @default(pending)
  remark         String?          @db.Text
  borrow_details borrow_details[]
  users          users            @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_borrow_user")

  @@index([user_id], map: "fk_borrow_user")
}

model repair_files {
  file_id   Int     @id @default(autoincrement()) @db.UnsignedInt
  repair_id Int     @db.UnsignedInt
  file_name String  @db.VarChar(255)
  file_path String  @db.VarChar(500)
  file_type String? @db.VarChar(100)
  repairs   repairs @relation(fields: [repair_id], references: [repair_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_repair_file_repair")

  @@index([repair_id], map: "idx_repair_files_repair")
}

model repairs {
  repair_id       Int             @id @default(autoincrement()) @db.UnsignedInt
  item_id         Int             @db.UnsignedInt
  reported_by     Int             @db.UnsignedInt
  issue           String          @db.Text
  repair_detail   String?         @db.Text
  repair_cost     Decimal?        @db.Decimal(10, 2)
  repair_date     DateTime        @default(now()) @db.DateTime(0)
  status          repairs_status  @default(pending_repair)
  repair_files    repair_files[]
  audit_records   audit_records[]
  equipment_items equipment_items @relation(fields: [item_id], references: [item_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_repair_item")
  users           users           @relation(fields: [reported_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_repair_user")

  @@index([reported_by], map: "fk_repair_user")
  @@index([item_id], map: "idx_repairs_item")
}

// รอบตรวจนับครุภัณฑ์ประจำปี เปิดได้ทีละรอบ (บังคับที่ audit.service.js) ปิดแล้วแก้ผลไม่ได้อีก
model audit_rounds {
  round_id      Int                 @id @default(autoincrement()) @db.UnsignedInt
  title         String              @db.VarChar(100)
  status        audit_rounds_status @default(open)
  opened_by     Int                 @db.UnsignedInt
  opened_at     DateTime            @default(now()) @db.DateTime(0)
  closed_by     Int?                @db.UnsignedInt
  closed_at     DateTime?           @db.DateTime(0)
  audit_records audit_records[]
  opened_user   users               @relation("audit_round_opened_by", fields: [opened_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_audit_round_opened_by")
  closed_user   users?              @relation("audit_round_closed_by", fields: [closed_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_audit_round_closed_by")

  @@index([opened_by], map: "fk_audit_round_opened_by")
  @@index([closed_by], map: "fk_audit_round_closed_by")
}

// หนึ่งแถว = ครุภัณฑ์หนึ่งชิ้นในรอบหนึ่ง สร้างครบทุกชิ้นตั้งแต่ตอนเปิดรอบ (result = null คือยังไม่ได้ตรวจ)
// ตรวจแล้วมีผลกับข้อมูลจริงทันที (ย้ายห้อง/แจ้งซ่อม) จึงต้องจำไว้ว่าเปลี่ยนอะไรไปบ้าง เผื่อกดผิดแล้วต้องย้อนคืน
model audit_records {
  record_id              Int                    @id @default(autoincrement()) @db.UnsignedInt
  round_id               Int                    @db.UnsignedInt
  item_id                Int                    @db.UnsignedInt
  // ห้องตามระบบ ณ ตอนเปิดรอบ ใช้นับว่าแต่ละห้องควรมีกี่ชิ้น ไม่เปลี่ยนตามตอนย้ายห้องระหว่างตรวจ
  expected_location_id   Int?                   @db.UnsignedInt
  result                 audit_records_result?
  note                   String?                @db.Text
  // ห้องที่ admin เลือกไว้ตอนสแกนเจอ (null = ตรวจโดยไม่ได้เลือกห้อง)
  found_location_id      Int?                   @db.UnsignedInt
  // true = การตรวจนี้ย้ายห้องของครุภัณฑ์ไปแล้ว moved_from คือห้องเดิมไว้ย้ายคืน (ห้องเดิมอาจเป็น null ได้)
  location_moved         Boolean                @default(false)
  moved_from_location_id Int?                   @db.UnsignedInt
  // ใบแจ้งซ่อมที่การตรวจนี้สร้างให้อัตโนมัติ (ผลชำรุด) ไว้ยกเลิกคืนถ้าแก้ผลกลับเป็นปกติ
  repair_id              Int?                   @db.UnsignedInt
  checked_by             Int?                   @db.UnsignedInt
  checked_at             DateTime?              @db.DateTime(0)
  // ชิ้นที่ไม่ได้ตรวจ ตัดสินตอนปิดรอบว่าไม่พบ/ถูกยืม/ซ่อม/ถูกลบ แล้วเก็บตายตัวไว้ ถ้าคิดสดจากสถานะปัจจุบัน
  // รายงานของรอบเก่าจะเปลี่ยนไปเอง เช่น ของที่ถูกยืมตอนปิดรอบ พอคืนแล้วจะกลายเป็น "ไม่พบ"
  closing_outcome        audit_closing_outcome?
  audit_rounds           audit_rounds           @relation(fields: [round_id], references: [round_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_audit_record_round")
  equipment_items        equipment_items        @relation(fields: [item_id], references: [item_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_audit_record_item")
  expected_location      locations?             @relation("audit_expected_location", fields: [expected_location_id], references: [location_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_audit_record_expected_location")
  found_location         locations?             @relation("audit_found_location", fields: [found_location_id], references: [location_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_audit_record_found_location")
  moved_from_location    locations?             @relation("audit_moved_from_location", fields: [moved_from_location_id], references: [location_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_audit_record_moved_from_location")
  repairs                repairs?               @relation(fields: [repair_id], references: [repair_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_audit_record_repair")
  users                  users?                 @relation(fields: [checked_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_audit_record_checked_by")

  @@unique([round_id, item_id], map: "uq_audit_record_round_item")
  @@index([item_id], map: "fk_audit_record_item")
  @@index([expected_location_id], map: "fk_audit_record_expected_location")
  @@index([found_location_id], map: "fk_audit_record_found_location")
  @@index([moved_from_location_id], map: "fk_audit_record_moved_from_location")
  @@index([repair_id], map: "fk_audit_record_repair")
  @@index([checked_by], map: "fk_audit_record_checked_by")
}

enum equipment_history_action {
  created
  updated
  status_changed
  deleted
  restored
}

// disposed = จำหน่ายออก ตั้งพร้อม deleted_at ตอนกด "จำหน่ายออก" เท่านั้น (ดู equipment.service.js deleteEquipment)
// เปลี่ยนเป็นสถานะนี้ตรงๆ ผ่าน PATCH /status ไม่ได้ เพราะต้องไปพร้อม deleted_at เสมอ ของที่จำหน่ายแล้วจึงหลุดจากทุกรายการ
enum equipment_items_status {
  available
  borrowed
  pending_repair
  repairing
  disposed
}

enum users_role {
  admin
  user
}

enum borrows_status {
  pending
  approved
  rejected
}

enum repairs_status {
  pending_repair
  repairing
  completed
  cancelled
}

enum audit_rounds_status {
  open
  closed
}

// ผลที่ admin กดเองตอนตรวจ ชิ้นที่ไม่ได้ตรวจ result เป็น null และได้ closing_outcome ตอนปิดรอบแทน
enum audit_records_result {
  normal
  damaged
}

enum audit_closing_outcome {
  missing
  borrowed
  in_repair
  deleted
}
