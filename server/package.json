{
  "name": "asset-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=src src/server.js",
    "start": "node src/server.js",
    "postinstall": "prisma generate --config prisma.config.js",
    "prisma:generate": "prisma generate --config prisma.config.js",
    "prisma:pull": "prisma db pull --config prisma.config.js",
    "prisma:studio": "prisma studio --config prisma.config.js",
    "prisma:migrate:dev": "prisma migrate dev --config prisma.config.js",
    "prisma:migrate:deploy": "prisma migrate deploy --config prisma.config.js",
    "prisma:migrate:status": "prisma migrate status --config prisma.config.js"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "prisma": "7.10.0"
  }
}
