# ค่าของ Express API
PORT=3000
# ใส่ได้หลาย URL คั่นด้วย comma เมื่อต้องทดสอบจากโทรศัพท์ในวง LAN
CLIENT_ORIGIN=http://localhost:5173,http://192.168.1.100:5173

# ข้อมูลสำหรับเชื่อม MySQL (เปลี่ยนให้ตรงกับเครื่องที่ใช้งาน)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=asset_management
DB_USER=root
DB_PASSWORD=root

# ใช้ลงลายเซ็น JWT ต้องสุ่มใหม่และมีอย่างน้อย 64 ตัวอักษร ห้ามใช้ค่านี้ในระบบจริง
JWT_SECRET=replace-this-example-with-your-own-random-secret-at-least-64-characters-long

# URL หน้าเว็บที่ใส่ในลิงก์ของอีเมล (ลิงก์ตั้งรหัสผ่านใหม่) ไม่ใส่จะใช้ค่าแรกของ CLIENT_ORIGIN
# production ใส่ URL จริง เช่น https://assetmath.up.railway.app
APP_URL=http://localhost:5173

# ส่งอีเมล "ลืมรหัสผ่าน" ผ่าน Brevo (brevo.com) ปล่อยว่างตอน dev ได้ ระบบจะพิมพ์อีเมลลง console แทน
# MAIL_FROM_EMAIL ต้องเป็นอีเมลที่ยืนยันแล้วในหน้า Senders ของ Brevo
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=ระบบจัดการวัสดุและครุภัณฑ์
