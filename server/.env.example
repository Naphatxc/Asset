# ค่าของ Express API
PORT=3000
# ใส่ได้หลาย URL คั่นด้วย comma เมื่อต้องทดสอบจากโทรศัพท์ในวง LAN
CLIENT_ORIGIN=http://localhost:5173,http://192.168.1.100:5173

# ข้อมูลสำหรับเชื่อม MySQL (เปลี่ยนให้ตรงกับเครื่องที่ใช้งาน)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=asset_management
DB_USER=root
DB_PASSWORD=root

# ใช้ลงลายเซ็น JWT ต้องสุ่มใหม่และมีอย่างน้อย 64 ตัวอักษร ห้ามใช้ค่านี้ในระบบจริง
JWT_SECRET=replace-this-example-with-your-own-random-secret-at-least-64-characters-long
